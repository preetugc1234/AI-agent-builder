# Backend Environment Variables
# Copy this file to .env and fill in your values

# App Configuration
DEBUG=False
API_VERSION=v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vibeagent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret (Generate a secure random string)
SECRET_KEY=your-super-secret-key-change-this-in-production

# OpenRouter (for NVIDIA Nemotron)
OPENROUTER_API_KEY=your-openrouter-api-key

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=vibeagent-storage
AWS_ECR_REGISTRY=your-ecr-registry-url
AWS_ECS_CLUSTER=vibeagent-cluster
AWS_KMS_KEY_ID=your-kms-key-id

# Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-encryption-key

# OAuth Credentials - Gmail
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# OAuth Credentials - Slack
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# OAuth Credentials - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth Credentials - Vercel
VERCEL_CLIENT_ID=your-vercel-client-id
VERCEL_CLIENT_SECRET=your-vercel-client-secret

# OAuth Credentials - Notion
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret

# OAuth Credentials - Google Sheets
GOOGLE_SHEETS_CLIENT_ID=your-google-sheets-client-id
GOOGLE_SHEETS_CLIENT_SECRET=your-google-sheets-client-secret

# Payment - Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Docker Registry
DOCKER_REGISTRY=your-docker-registry

# Cloudflare
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
