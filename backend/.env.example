# NodeRush Backend - Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================
# REQUIRED - Core Settings
# ===========================

# Database - Supabase PostgreSQL Connection String
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/noderush

# Redis - Upstash Redis Connection String
# Format: redis://default:[PASSWORD]@[ENDPOINT]:6379
REDIS_URL=redis://localhost:6379/0

# JWT Secret Key (generate a strong random key for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# OpenRouter API Key (for NVIDIA Nemotron free model)
OPENROUTER_API_KEY=your-openrouter-api-key

# ===========================
# OPTIONAL - OAuth Integrations
# ===========================

# Gmail OAuth (for Gmail integration)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Slack OAuth (for Slack integration)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub OAuth (for GitHub integration)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notion OAuth (for Notion integration)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Google Sheets OAuth (for Google Sheets integration)
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# ===========================
# OPTIONAL - Payment Gateway
# ===========================

# Razorpay (for Indian payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===========================
# Application Settings
# ===========================

# Debug mode (set to false in production)
DEBUG=false
